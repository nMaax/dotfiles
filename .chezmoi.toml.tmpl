{{- $profile := promptStringOnce . "profile" "\n🧭 Profile (full / laptop / gaming / design / minimal / custom)" "gaming" | lower | trim -}}

{{- $on := dict
	"full" (list "ai_agents" "coding" "local_llm" "gaming" "media" "design" "office" "printing" "communication" "plugins")
	"laptop" (list "ai_agents" "coding" "media" "office" "printing" "communication")
	"gaming" (list "ai_agents" "gaming" "media" "communication")
	"design" (list "ai_agents" "design" "media" "communication")
	"minimal" (list) -}}

{{- if and (ne $profile "custom") (not (hasKey $on $profile)) -}}
{{-   fail (printf "Unknown profile %q: expected one of full, laptop, gaming, design, minimal, custom" $profile) -}}
{{- end -}}

{{- $suggestedName := output "sh" "-c" "n=$(git config --get user.name 2>/dev/null || true); [ -n \"$n\" ] || n=$(getent passwd \"${USER:-$(id -un)}\" 2>/dev/null | cut -d: -f5 | cut -d, -f1 || true); printf '%s' \"$n\"" | trim -}}
{{- $suggestedEmail := output "sh" "-c" "git config --get user.email 2>/dev/null || true" | trim -}}
{{- $data := dict
	"name" (promptStringOnce . "name" "\n👤 Git author name (shown on commits)" $suggestedName)
	"email" (promptStringOnce . "email" "📧 Git email (shown on commits)" $suggestedEmail)
	"profile" $profile -}}

{{- $profileChanged := ne $data.profile (get $ "profile" | default "") -}}
{{- range list
	(list "ai_agents" "\n🤖 Install AI agents (Claude Code/Antigravity/Codex/…)")
	(list "coding" "💻 Install dev tooling (VS Code/lazygit/Node.js/Python/…)")
	(list "local_llm" "🧠 Install local LLMs (CUDA/ROCm/Ollama)")
	(list "gaming" "🎮 Install gaming stack (Steam/OpenRGB/…)")
	(list "media" "🎬 Install media apps (kdenlive/OBS/Spotify/…)")
	(list "design" "🎨 Install design apps (ArtCraft suite)")
	(list "office" "📄 Install office apps (Office suite/Xournal++/qBittorrent/…)")
	(list "printing" "🖨️ Install printing (CUPS + drivers)")
	(list "communication" "💬 Install chat apps (Telegram/Signal/Discord/…)")
	(list "plugins" "🧩 Install Hyprland plugins (hyprpm/scrolloverview)") -}}
{{-   $key := index . 0 -}}
{{-   if eq $data.profile "custom" -}}
{{-     $default := ternary (get $ $key) true (hasKey $ $key) -}}
{{-     $_ := set $data $key (promptBoolOnce $ $key (index . 1) $default) -}}
{{-   else if and (not $profileChanged) (hasKey $ $key) -}}
{{-     $_ := set $data $key (get $ $key) -}}
{{-   else -}}
{{-     $_ := set $data $key (has $key (get $on $data.profile)) -}}
{{-   end -}}
{{- end -}}

{{- $terminals := promptMultichoiceOnce . "terminals" "\n🖥️ Terminals" (list "ghostty" "kitty" "alacritty" "foot") (list "ghostty" "foot") -}}
{{- if eq (len $terminals) 0 -}}
{{-   $terminals = list "foot" -}}
{{- end -}}
{{- $defaultTerminal := index $terminals 0 -}}
{{- if gt (len $terminals) 1 -}}
{{-   $fallbackTerminal := ternary "foot" (index $terminals 0) (has "foot" $terminals) -}}
{{-   $defaultTerminal = promptStringOnce . "default_terminal" (printf "🖥️ Default terminal (%s)" (join " / " $terminals)) $fallbackTerminal | lower | trim -}}
{{-   if not (has $defaultTerminal $terminals) -}}
{{-     fail (printf "Unknown default_terminal %q: expected one of %s" $defaultTerminal (join ", " $terminals)) -}}
{{-   end -}}
{{- end -}}

{{- $agents := list -}}
{{- if $data.ai_agents -}}
{{-   $agents = promptMultichoiceOnce . "agents" "\n🤖 Favorite Agents" (list "claude-code" "claude-desktop" "agy" "codex" "opencode" "hermes" "omp" "pi") (list "claude-code" "agy") -}}
{{- end -}}
{{- $_ := set $data "agents" $agents -}}

{{- $officeSuites := list -}}
{{- if $data.office -}}
{{-   $officeSuites = promptMultichoiceOnce . "office_suites" "\n📄 Favorite Office suites" (list "artcraft" "libreoffice" "onlyoffice") (list "artcraft") -}}
{{- end -}}
{{- $_ := set $data "office_suites" $officeSuites -}}

{{- $designApps := list -}}
{{- if $data.design -}}
{{-   $designApps = promptMultichoiceOnce . "design_apps" "\n🎨 Favorite Design apps" (list "designcraft" "effectcraft" "filmcraft" "lightcraft" "photocraft" "vectorcraft" "blender" "gimp") (list "filmcraft" "lightcraft" "photocraft") -}}
{{- end -}}
{{- $_ := set $data "design_apps" $designApps -}}

{{- $commApps := list -}}
{{- if $data.communication -}}
{{-   $commApps = promptMultichoiceOnce . "communication_apps" "\n💬 Favorite Communication apps" (list "telegram" "signal" "element" "discord" "wechat" "localsend" "whatsapp") (list "telegram" "discord" "localsend" "whatsapp") -}}
{{- end -}}
{{- $_ := set $data "communication_apps" $commApps -}}

{{/* <service>_authkey: false skips, "" installs without login, else the key */}}
{{- range list
	(list "tailscale" "Tailscale" "auth key" "\n🔗")
	(list "nordvpn" "NordVPN" "token" "🛡️")
	(list "mega" "MEGA" "session id (from mega-session)" "☁️") -}}
{{-   $key := printf "%s_authkey" (index . 0) -}}
{{-   $val := false -}}
{{-   if hasKey $ $key -}}
{{-     $val = get $ $key -}}
{{-   else if promptBool (printf "%s Install %s" (index . 3) (index . 1)) false -}}
{{-     $val = promptString (printf "   🔑 %s %s (empty for no auto-login)" (index . 1) (index . 2)) "" -}}
{{-   end -}}
{{-   $_ := set $data $key $val -}}
{{- end -}}

[data]
  # Git identity
  name = {{ $data.name | quote }}
  email = {{ $data.email | quote }}

  # Profile preset (used at chezmoi init to populate unset flags below)
  profile = {{ $data.profile | quote }}

  # Feature flags
  ai_agents = {{ $data.ai_agents }}
  coding = {{ $data.coding }}
  local_llm = {{ $data.local_llm }}
  gaming = {{ $data.gaming }}
  media = {{ $data.media }}
  design = {{ $data.design }}
  office = {{ $data.office }}
  printing = {{ $data.printing }}
  communication = {{ $data.communication }}
  plugins = {{ $data.plugins }}

  # App selections
  terminals = {{ $terminals | toJson }}
  default_terminal = {{ $defaultTerminal | quote }}
  agents = {{ $data.agents | toJson }}
  communication_apps = {{ $data.communication_apps | toJson }}
  design_apps = {{ $data.design_apps | toJson }}
  office_suites = {{ $data.office_suites | toJson }}

  # Optional services (false = skip, "" = install without login, "<key>" = log in)
  tailscale_authkey = {{ if kindIs "bool" $data.tailscale_authkey }}{{ $data.tailscale_authkey }}{{ else }}{{ $data.tailscale_authkey | quote }}{{ end }}
  nordvpn_authkey = {{ if kindIs "bool" $data.nordvpn_authkey }}{{ $data.nordvpn_authkey }}{{ else }}{{ $data.nordvpn_authkey | quote }}{{ end }}
  mega_authkey = {{ if kindIs "bool" $data.mega_authkey }}{{ $data.mega_authkey }}{{ else }}{{ $data.mega_authkey | quote }}{{ end }}
