{{- $data := dict
	"name" (promptStringOnce . "name" "Name")
	"email" (promptStringOnce . "email" "Email")
	"profile" (promptChoiceOnce . "profile" "Profile (presets the answers below)" (list "full" "laptop" "gaming" "minimal") "full") -}}

{{- $on := get (dict
	"full" (list "coding" "local_llm" "gaming" "media" "office" "printing" "communication" "plugins")
	"laptop" (list "coding" "media" "office" "printing" "communication")
	"gaming" (list "gaming" "media" "communication" "plugins")
	"minimal" (list)) $data.profile -}}

{{- range list
	(list "gaming" "gaming stack (Steam/OpenRGB/…)")
	(list "coding" "dev tooling and AI agents (VS Code/lazygit/Claude Code/…)")
	(list "local_llm" "local LLMs (CUDA/ROCm/Ollama)")
	(list "media" "media apps (kdenlive/OBS/Spotify/…)")
	(list "office" "office apps (LibreOffice/Xournal++/qBittorrent/…)")
	(list "printing" "printing (CUPS + drivers)")
	(list "communication" "chat apps (Telegram/Signal/Discord/…)")
	(list "plugins" "Hyprland plugins (hyprpm/scrolloverview)") -}}
{{-   $_ := set $data (index . 0) (promptBoolOnce $ (index . 0) (printf "Install %s" (index . 1)) (has (index . 0) $on)) -}}
{{- end -}}

{{/* <service>_authkey: false skips, "" installs without login, else the key */}}
{{- range list
	(list "tailscale" "Tailscale" "auth key")
	(list "nordvpn" "NordVPN" "token")
	(list "mega" "MEGA" "session id (from mega-session)") -}}
{{-   $key := printf "%s_authkey" (index . 0) -}}
{{-   $val := false -}}
{{-   if hasKey $ $key -}}
{{-     $val = get $ $key -}}
{{-   else if promptBool (printf "Install %s" (index . 1)) false -}}
{{-     $val = promptString (printf "%s %s (empty for no auto-login)" (index . 1) (index . 2)) "" -}}
{{-   end -}}
{{-   $_ := set $data $key $val -}}
{{- end -}}

{{ toToml (dict "data" $data) }}
