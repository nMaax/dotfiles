{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.logo",
    "type": "kitty",
    "height": 15,
    "padding": {
      "top": 2,
      "left": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "default"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "key": "╭───────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "│ 󰻀  distro",
      "format": "{pretty-name>30} │"
    },
    {
      "type": "kernel",
      "key": "│   kernel",
      "format": "{release>30} │"
    },
    {
      "type": "command",
      "key": "│   uptime",
      "text": "uptime -p | cut -d ' ' -f 2-",
      "format": "{1>30} │"
    },
    {
      "type": "shell",
      "key": "│   shell ",
      "format": "{pretty-name>30} │"
    },
    {
      "type": "terminal",
      "key": "│   term  ",
      "format": "{pretty-name>30} │"
    },
    {
      "type": "wm",
      "key": "│   wm    ",
      "format": "{pretty-name>30} │"
    },
    {
      "type": "cpu",
      "key": "│   cpu   ",
      "format": "{name>30} │"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮  gpu   ",
      "hideType": "integrated",
      "format": "{name>30} │"
    },
    {
      "type": "command",
      "key": "│   mem   ",
      "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
      "format": "{1>30} │"
    },
    {
      "type": "packages",
      "key": "│   pkgs  ",
      "format": "{pacman>12} pacman, {flatpak-all} flatpak │"
    },
    {
      "type": "command",
      "key": "│   aur   ",
      "text": "pacman -Qm | wc -l",
      "format": "{1>30} │"
    },
    {
      "type": "command",
      "key": "│   user  ",
      "text": "echo $USER",
      "format": "{1>30} │"
    },
    {
      "type": "command",
      "key": "│   hname ",
      "text": "hostnamectl hostname",
      "format": "{1>30} │"
    },
    {
      "type": "custom",
      "key": "╰───────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
