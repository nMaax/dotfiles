# Session environment — sourced by UWSM before Hyprland starts.

export BROWSER=zen-browser
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/default-terminal" ] && read -r TERMINAL < "${XDG_CONFIG_HOME:-$HOME/.config}/default-terminal"
export TERMINAL="${TERMINAL:-ghostty}"

export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"
export SSH_ASKPASS=/usr/bin/ksshaskpass

export HYPRCURSOR_SIZE=24
export XCURSOR_SIZE=24

export XDG_MENU_PREFIX=arch-

# KDE platform theme reads Noctalia's kdeglobals (qt6ct hides Dolphin filenames in dark mode)
export QT_QPA_PLATFORMTHEME=kde
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_QPA_PLATFORM="wayland;xcb"

export ELECTRON_OZONE_PLATFORM_HINT=auto
