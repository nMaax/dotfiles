#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

{{ if and .ai_agents (gt (len .agents) 0) -}}
echo ""
info "🤖 [Installing Apps: AI Agents] Starting..."
echo ""

{{- if has "claude-code" .agents }}
info "🦀 Installing Claude Code..."
if command -v claude &>/dev/null; then
  success "Claude Code is already installed (it self-updates). Skipping."
else
  curl -fsSL "$CLAUDE_INSTALL_URL" | bash
fi
{{- end }}

{{- if has "claude-desktop" .agents }}
info "🖥️ Installing Claude Desktop..."
sudo pacman -S --needed --noconfirm claude-desktop # Available directly in the cachyos repo
{{- end }}

{{- if has "agy" .agents }}
info "💎 Installing Antigravity CLI..."
if [ -x "$HOME/.local/bin/agy" ]; then
  success "Antigravity CLI is already installed (it self-updates). Skipping."
else
  curl -fsSL "$ANTIGRAVITY_INSTALL_URL" | bash
fi
{{- end }}

{{- if has "opencode" .agents }}
info "🔳 Installing OpenCode..."
sudo pacman -S --needed --noconfirm opencode
{{- end }}

{{- if has "codex" .agents }}
info "🧠 Installing Codex CLI..."
if command -v codex &>/dev/null; then
  success "Codex CLI is already installed (it self-updates). Skipping."
else
  curl -fsSL "$CODEX_INSTALL_URL" | sh
fi
{{- end }}

{{- if has "hermes" .agents }}
info "⚕️ Installing Hermes Agent..."
sudo pacman -S --needed --noconfirm hermes-agent # Available directly in the cachyos repo
{{- end }}

{{- if has "omp" .agents }}
info "🥧 Installing Oh My Pi (omp)..."
paru -S --needed --noconfirm oh-my-pi-bin
{{- end }}

{{- if has "pi" .agents }}
info "🥧 Installing Pi coding agent..."
paru -S --needed --noconfirm pi-coding-agent-bin
{{- end }}

info "📊 Installing ai-usagebar (backend for the Noctalia plugin)..."
paru -S --needed --noconfirm ai-usagebar-bin

echo ""
success "✅ [Installing Apps: AI Agents] Done."
echo ""
{{- end }}
