#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}

echo ""
info "🌐 [Installing Webapps] Starting..."
echo ""

info "♊ Installing Gemini Webapp..."
~/.local/bin/install-webapp "Gemini" "https://gemini.google.com/app"

info "🤖 Installing Copilot Webapp..."
~/.local/bin/install-webapp "Copilot" "https://github.com/copilot" "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/github-copilot.png"

info "💬 Installing ChatGPT Webapp..."
~/.local/bin/install-webapp "ChatGPT" "https://chatgpt.com" "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/chatgpt.png"

info "🧠 Installing Claude Webapp..."
~/.local/bin/install-webapp "Claude" "https://claude.ai" "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/claude-ai.png"

# NOTE: this line used to pass an extra leading "install-webapp" argument, which
# made APP_NAME and APP_URL both "install-webapp" -- that is where the stray
# ~/.local/share/applications/install-webapp.desktop came from, and why no
# Ask-Brave entry was regenerated. Removing that argument is the fix; delete the
# stray .desktop by hand (see CLEANUP.md).
info "🦁 Installing Brave AI..."
~/.local/bin/install-webapp "Ask Brave" "https://search.brave.com/ask"

info "🖱️ Installing MCHOOSE HUB Webapp..."
~/.local/bin/install-webapp "MCHOSE HUB" "https://www.mchose.com.cn/#/connectDevice"

info "📝 Installing ddocs webapp..."
~/.local/bin/install-webapp "ddocs" "https://ddocs.new"

info "📞 Installing WhatsApp webapp..."
~/.local/bin/install-webapp "WhatsApp" "https://web.whatsapp.com"

echo ""
success "✅ [Installing Webapps] Done."
echo ""
