#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

echo ""
info "🌐 [Installing Webapps] Starting..."
echo ""

info "♊ Installing Gemini Webapp..."
~/.local/bin/install-webapp "Gemini" "$GEMINI_URL"

info "🤖 Installing Copilot Webapp..."
~/.local/bin/install-webapp "Copilot" "$COPILOT_URL" "$COPILOT_ICON_URL"

info "💬 Installing ChatGPT Webapp..."
~/.local/bin/install-webapp "ChatGPT" "$CHATGPT_URL" "$CHATGPT_ICON_URL"

info "🦁 Installing Brave AI..."
~/.local/bin/install-webapp "Ask Brave" "$BRAVE_ASK_URL"

{{ if .gaming -}}
info "🖱️ Installing MCHOSE HUB Webapp..."
~/.local/bin/install-webapp "MCHOSE HUB" "$MCHOSE_HUB_URL"
{{- end }}

info "📝 Installing ddocs webapp..."
~/.local/bin/install-webapp "ddocs" "$DDOCS_URL"

info "⬇️ Installing cobalt webapp..."
~/.local/bin/install-webapp "cobalt" "$COBALT_URL"

{{ if .communication -}}
info "📞 Installing WhatsApp webapp..."
~/.local/bin/install-webapp "WhatsApp" "$WHATSAPP_URL"
{{- end }}

echo ""
success "✅ [Installing Webapps] Done."
echo ""
