#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

echo ""
info "🌙 [Hyprland & Noctalia] Starting..."
echo ""

info "💧 Installing Hyprland core..."
sudo pacman -S --needed --noconfirm hyprland xdg-desktop-portal-hyprland

info "🌙 Installing Noctalia dependencies..."
sudo pacman -S --needed --noconfirm ddcutil
warn "[NOCTALIA] ddcutil may cause instability on some monitors; remove it if needed with: sudo pacman -Rns ddcutil"
paru -S --needed --noconfirm cliphist wlsunset xdg-desktop-portal evolution-data-server hyprshot

info "🦉 Installing Noctalia..."
paru -S --needed --noconfirm noctalia-shell
# NOTE: v4 (noctalia-shell) is being KEPT INSTALLED on purpose, as a fallback
# with its own working settings, alongside the new v5 beta below. Per
# https://docs.noctalia.dev/v5/getting-started/faq/ : v4 and v5 don't
# conflict as packages (confirmed via `pacman -Si noctalia`: conflicts only
# with noctalia-git/noctalia-bin, NOT noctalia-shell) and their config files
# don't collide either (v4 = JSON, v5 = TOML, different filenames) -- so
# both can coexist and either can be launched independently. v5's plugin
# ecosystem is also still very early (most v4 plugins have no v5 equivalent
# yet), which is the other reason not to burn the v4 bridge yet.
#
# v5 is a full rewrite: no longer built on quickshell at all (a native
# binary), new IPC scheme ("noctalia msg <command>" instead of
# "qs -c noctalia-shell ipc call"), new app id (dev.noctalia.Noctalia).
# Available directly in the cachyos repo, so pacman (not paru) is enough.
sudo pacman -S --needed --noconfirm noctalia
info "[NOCTALIA] Built-in app theming is pre-enabled for common apps."
info "Remaining app-specific steps: https://docs.noctalia.dev/v5/theming/app-theming/"
warn "[NOCTALIA] v5 has NO automatic settings migration from v4 (official, not a gap on our end)."
warn "Your v4 dot_config/noctalia/settings.json + plugins.json (bar layout, pinned apps, enabled"
warn "plugins, etc.) will NOT carry over -- v5 reads its own separate *.toml files instead."
warn "You'll need to reconfigure the bar/panels/plugins from scratch via v5's own Settings UI."
info "[NOCTALIA] v4 (noctalia-shell) is kept installed as a fallback -- when you're ready to drop"
info "it for good, see ~/.local/bin/noctalia-v4-cleanup.sh (not run automatically)."

info "🔍 Installing Quickshell Overview..."
paru -S --needed --noconfirm quickshell-overview-git

info "🩸 Setting hyprland plugins..."
if ! hyprpm list | grep -q hyprland-scroll-overview; then
  hyprpm add https://github.com/yayuuu/hyprland-scroll-overview.git
  hyprpm update
  hyprpm enable scrolloverview
else
  success "hyprland-scroll-overview plugin already installed and enabled, skipping."
fi

info "🖼️ Installing mpvpaper for Video Wallpaper alternative backend..."
paru -S --needed --noconfirm mpvpaper

info "🀄 Syncing GTK with Noctalia and removing decorations..."
gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3'
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
gsettings set org.gnome.desktop.wm.preferences button-layout ':'

echo ""
success "✅ [Hyprland & Noctalia] Done."
echo ""
