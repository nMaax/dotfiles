#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

echo ""
info "🚀 [Installing Apps: Core] Starting..."
echo ""

info "🌊 Installing browsers..."
sudo pacman -S --needed --noconfirm chromium zen-browser-bin

{{- if gt (len .terminals) 0 }}
info "🖥️ Installing terminals ({{ .terminals | join ", " }})..."
sudo pacman -S --needed --noconfirm {{ .terminals | join " " }}
{{- end }}

info "🪐 Installing Starship..."
sudo pacman -S --needed --noconfirm starship

info "🦆 Installing yazi..."
sudo pacman -S --needed --noconfirm yazi

info "🔐 Installing hyprpolkitagent..."
sudo pacman -S --needed --noconfirm hyprpolkitagent

info "📝 Installing Neovim and uv..."
sudo pacman -S --needed --noconfirm neovim uv

info "🔑 Installing KeePassXC and GNOME Calculator..."
sudo pacman -S --needed --noconfirm keepassxc gnome-calculator

echo ""
success "✅ [Installing Apps: Core] Done."
echo ""
