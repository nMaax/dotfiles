#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

echo ""
info "📦 [Prerequisites & Base Packages] Starting..."
echo ""

{{ if .gaming -}}
info "🎮 gaming = true detected, ensuring CachyOS gaming packages are installed..."
if ! sudo pacman -S --needed --noconfirm cachyos-gaming-meta cachyos-gaming-applications; then
  error "Failed to install CachyOS gaming packages. Please resolve the pacman issue and re-run. Closing."
  exit 1
fi
cachyos-hello fix install-vram-management
success "✅ CachyOS gaming packages are now installed."
{{- end }}

info "📁 Creating common directories..."
mkdir -p "$HOME/Pictures/Screenshots/"
xdg-user-dirs-update

info "📦 Installing base packages..."
sudo pacman -S --needed --noconfirm binutils base-devel git vim cmake cpio appmenu-gtk-module libdbusmenu-glib

info "🔧 Installing other utilities..."
sudo pacman -S --needed --noconfirm paru curl zip 7zip sshfs caligula smartmontools grim slurp wl-clipboard ffmpeg resvg imagemagick perl-image-exiftool gifski zbar jq tesseract tesseract-data-eng tesseract-data-ita texlive-latex glow dust bat ripgrep fd htop btop fastfetch nvtop trash-cli transmission-cli ghostscript poppler qpdf ufw tealdeer ksshaskpass fzf zoxide direnv translate-shell
paru -S --needed --noconfirm pdfcpu-bin ocrmypdf pandoc-bin
{{ if .gaming -}}
paru -S --needed --noconfirm hyprland-focused-booster
{{- end }}

# rocm-smi-lib is btop/nvtop's optional dep for showing AMD GPU stats
detect_gpu_vendor
if [ "$GPU_VENDOR" = "amd" ]; then
  sudo pacman -S --needed --noconfirm rocm-smi-lib
fi

info "🖥️ Installing KDE suite, Qt, GTK and utility apps..."
if pacman -Q qt6ct-kde &>/dev/null; then
  success "qt6ct-kde is already installed. Skipping."
elif pacman -Q qt6ct &>/dev/null; then
  warn "qt6ct is pre-installed; installing qt6ct-kde (recommended by Noctalia) will remove qt6ct."
  if ask "Replace qt6ct with qt6ct-kde?"; then
    paru -S --needed qt6ct-kde qt5ct-kde
  else
    warn "Skipped qt6ct-kde / qt5ct-kde."
  fi
else
  paru -S --needed --noconfirm qt6ct-kde qt5ct-kde
fi
sudo pacman -S --needed --noconfirm \
  adw-gtk-theme nwg-look \
  qt6-multimedia archlinux-xdg-menu ark dolphin-plugins filelight \
  okular haruna gnome-text-editor gwenview \
  kwallet kwalletmanager kwallet-pam

GIT_NAME={{ .name | quote }}
GIT_EMAIL={{ .email | quote }}

info "🐙 Setting Git identity from config..."
git config --global user.name "$GIT_NAME"
git config --global user.email "$GIT_EMAIL"
info "Git identity set: $GIT_NAME <$GIT_EMAIL>"

echo ""
success "✅ [Prerequisites & Base Packages] Done."
echo ""
