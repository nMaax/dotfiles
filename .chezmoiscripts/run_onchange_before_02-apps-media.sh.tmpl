#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

{{ if .media -}}
echo ""
info "🚀 [Installing Apps: Media] Starting..."
echo ""

info "✨ Installing Image upscaler..."
paru -S --needed --noconfirm realesrgan-ncnn-vulkan-bin

info "🎴 Installing YouTube downloader..."
sudo pacman -S --needed --noconfirm yt-dlp

info "🎬 Installing KDenlive and OBS Studio..."
sudo pacman -S --needed --noconfirm kdenlive obs-studio

info "📹 Installing OBS Plugins for game capture and streaming..."
sudo pacman -S --needed --noconfirm obs-vkcapture lib32-obs-vkcapture
paru -S --needed --noconfirm obs-pipewire-audio-capture-bin

info "🎨 Installing ArtCraft suite..."
paru -S --needed --noconfirm {design,effect,film,light,pdf,photo,vector}craft-bin

info "🎵 Installing EasyEffects and audio effect plugins..."
sudo pacman -S --needed --noconfirm easyeffects lsp-plugins zam-plugins calf mda.lv2

info "🎧 Installing Spotify & Spicetify..."
SPICETIFY_SETUP="$(mktemp)"
trap 'rm -f "$SPICETIFY_SETUP"' EXIT
cat >"$SPICETIFY_SETUP" <<'SPICETIFY_SETUP_EOF'
{{ include "dot_local/bin/executable_spicetify-setup.sh" }}
SPICETIFY_SETUP_EOF
bash "$SPICETIFY_SETUP" "$SPICETIFY_COMFY_REPO_URL" "$SPICETIFY_MARKETPLACE_INSTALL_URL"

echo ""
success "✅ [Installing Apps: Media] Done."
echo ""
{{- end }}
