#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

echo ""
info "🩸 [Hyprland Plugins] Starting..."
echo ""

if ! hyprland_is_running; then
  warn "Hyprland is not currently running — skipping plugin setup. This will retry automatically on the next chezmoi apply once you're in a Hyprland session."
else
  if ! hyprpm list | grep -q hyprland-scroll-overview; then
    hyprpm add "$SCROLLOVERVIEW_REPO_URL"
    hyprpm update
    hyprpm enable scrolloverview
  else
    success "hyprland-scroll-overview plugin already installed and enabled, skipping."
  fi
fi

echo ""
success "✅ [Hyprland Plugins] Done."
echo ""
