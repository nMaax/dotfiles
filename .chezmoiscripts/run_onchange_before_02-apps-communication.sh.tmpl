#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

{{ if and .communication (gt (len .communication_apps) 0) -}}
echo ""
info "🚀 [Installing Apps: Communication] Starting..."
echo ""

{{- $repo := list }}
{{- if has "telegram" .communication_apps }}{{ $repo = append $repo "telegram-desktop" }}{{ end }}
{{- if has "signal" .communication_apps }}{{ $repo = append $repo "signal-desktop" }}{{ end }}
{{- if has "element" .communication_apps }}{{ $repo = append $repo "element-desktop" }}{{ end }}
{{- if has "discord" .communication_apps }}{{ $repo = append $repo "discord" }}{{ end }}
{{- if has "localsend" .communication_apps }}{{ $repo = append $repo "localsend" }}{{ end }}

{{- if gt (len $repo) 0 }}
info "🔗 Installing {{ join ", " $repo }}..."
sudo pacman -S --needed --noconfirm{{ range $repo }} {{ . }}{{ end }}
{{- end }}

{{- if has "wechat" .communication_apps }}
info "💬 Installing WeChat..."
paru -S --needed --noconfirm wechat-bin
{{- end }}

echo ""
success "✅ [Installing Apps: Communication] Done."
echo ""
{{- end }}
