#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

{{ if .communication -}}
echo ""
info "🚀 [Installing Apps: Communication] Starting..."
echo ""

info "🔗 Installing Telegram and Signal"
sudo pacman -S --needed --noconfirm telegram-desktop signal-desktop

info "🔬 Installing Element..."
sudo pacman -S --needed --noconfirm element-desktop

info "👾 Installing Discord..."
sudo pacman -S --needed --noconfirm discord

info "📤 Installing LocalSend..."
sudo pacman -S --needed --noconfirm localsend

echo ""
success "✅ [Installing Apps: Communication] Done."
echo ""
{{- end }}
