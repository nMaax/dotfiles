#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

echo ""
info "🏔️ [Nord VPN] Starting..."
echo ""

{{- if ne (printf "%v" .nordvpn_token) "false" }}
info "🔒 Installing NordVPN from AUR..."
paru -S --noconfirm --needed nordvpn-bin

info "Enabling NordVPN daemon..."
sudo systemctl enable --now nordvpnd
sudo usermod -aG nordvpn "$USER"
sleep 2
warn "[NORDVPN] A new system group was added. Reboot your system."

{{- if .nordvpn_token }}
info "Logging into NordVPN using provided token..."
if ! sudo -g nordvpn -u "$USER" nordvpn account &>/dev/null; then
  sudo -g nordvpn -u "$USER" nordvpn login --token {{ .nordvpn_token }}
else
  success "Already logged into NordVPN. Skipping login."
fi

# Proceed with settings configuration
if sudo -g nordvpn -u "$USER" nordvpn status | grep -E -q "Status: (Connected|Disconnected)"; then
  sudo -g nordvpn -u "$USER" nordvpn set dns off
  sudo -g nordvpn -u "$USER" nordvpn set threatprotection off
  sudo -g nordvpn -u "$USER" nordvpn set post-quantum on
  sudo -g nordvpn -u "$USER" nordvpn set firewall on
  success "NordVPN configured successfully."
fi

if ask "🧹 Remove 'nordvpn_token' from ~/.config/chezmoi/chezmoi.toml now? (under [data], set nordvpn_token = \"\" or false)"; then
  reset_chezmoi_data_secret "nordvpn_token" "Leave \"\" or false if you want to skip nordvpn"
fi
{{- else }}
warn "No 'nordvpn_token' found in chezmoi.toml. Skipping auto-login."
{{- end }}
{{- else }}
warn "'nordvpn_token' set to false. Skipping NordVPN entirely."
{{- end }}

echo ""
success "✅ [Nord VPN] Done."
echo ""
