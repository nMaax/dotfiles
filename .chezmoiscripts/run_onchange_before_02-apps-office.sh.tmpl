#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

{{ if .office -}}
echo ""
info "🚀 [Installing Apps: Office] Starting..."
echo ""

info "🔑 Installing KeePassXC..."
sudo pacman -S --needed --noconfirm keepassxc

info "📥 Installing qBitTorrent..."
sudo pacman -S --needed --noconfirm qbittorrent

info "🧮 Installing GNOME Calculator..."
sudo pacman -S --needed --noconfirm gnome-calculator

info "📊 Installing sc-im spreadsheet..."
paru -S --needed --noconfirm sc-im

info "☁️ Installing MEGA CMD..."
if pacman -Qi "megacmd" >/dev/null 2>&1; then
  success "MEGA is already installed. Skipping..."
else
  wget "$MEGACMD_URL"
  sudo pacman -U "$PWD/megacmd-x86_64.pkg.tar.zst"
fi

info "📄 Installing LibreOffice and Xournal++..."
sudo pacman -S --needed --noconfirm libreoffice-fresh xournalpp

echo ""
success "✅ [Installing Apps: Office] Done."
echo ""
{{- end }}
