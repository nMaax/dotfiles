#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

{{ if .office -}}
echo ""
info "🚀 [Installing Apps: Office] Starting..."
echo ""

info "📥 Installing qBitTorrent..."
sudo pacman -S --needed --noconfirm qbittorrent

info "📊 Installing sc-im spreadsheet..."
paru -S --needed --noconfirm sc-im

info "📄 Installing Xournal++..."
sudo pacman -S --needed --noconfirm xournalpp

{{- if has "libreoffice" .office_suites }}
info "📄 Installing LibreOffice..."
sudo pacman -S --needed --noconfirm libreoffice-fresh
{{- end }}

{{- if has "onlyoffice" .office_suites }}
info "📄 Installing ONLYOFFICE..."
paru -S --needed --noconfirm onlyoffice-bin
{{- end }}

{{- if has "artcraft" .office_suites }}
info "✍️ Installing WordCraft, GridCraft, DeckCraft and PDFCraft..."
paru -S --needed --noconfirm {word,grid,deck,pdf}craft-bin
{{- end }}

INSTALL_NOTION=true
warn "The notion-app-electron-bin AUR package is currently faulty (upstream AUR issue)."
if ask "Skip installing Notion until the package is fixed? (recommended)"; then
  INSTALL_NOTION=false
fi
if [ "$INSTALL_NOTION" = "true" ]; then
  info "🗒️ Installing Notion..."
  paru -S --needed --noconfirm notion-app-electron-bin
else
  warn "Skipped Notion install."
fi

echo ""
success "✅ [Installing Apps: Office] Done."
echo ""
{{- end }}
