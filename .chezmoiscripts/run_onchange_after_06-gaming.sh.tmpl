#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}


{{ if .gaming -}}
success "🎮 Gaming flag is set. Applying optimizations..."

info "🛸 Installing Millennium..."
paru -S --needed --noconfirm millennium

info "🦚 Installing OpenRGB..."
sudo pacman -S --needed --noconfirm openrgb

info "🎎 Installing Wallpaper Engine compatibility layer..."
paru -S --needed --noconfirm linux-wallpaperengine-git

info "⛏️ Installing Minecraft (Prism-launcher and Java dependencies)..."
sudo pacman -S --needed --noconfirm prismlauncher
sudo pacman -S --needed --noconfirm jdk8-openjdk jdk17-openjdk jdk21-openjdk

info "💎 Installing Amethyst Mod Manager..."
paru -S --needed --noconfirm amethyst-mod-manager

info "🥭 Installing mango and mangojuice..."
sudo pacman -S --needed --noconfirm mangohud mangojuice

info "💓 Installing vrrtest..."
paru -S --needed --noconfirm vrrtest

info "📹 Installing OBS Plugins for game capture and streaming..."
sudo pacman -S --needed --noconfirm obs-vkcapture lib32-obs-vkcapture
paru -S --needed --noconfirm obs-pipewire-audio-capture-bin

detect_gpu_vendor
if [ "$GPU_VENDOR" = "amd" ]; then
  info "🔺 Installing Mesa implicit Vulkan layers (anti-lag)..."
  sudo pacman -S --needed --noconfirm vulkan-mesa-implicit-layers lib32-vulkan-mesa-implicit-layers
fi

if pacman -Q gamemode >/dev/null 2>&1; then
  info "Feral's gamemode detected. Checking for ananicy-cpp conflicts..."
  if systemctl is-enabled --quiet ananicy-cpp 2>/dev/null || systemctl is-active --quiet ananicy-cpp 2>/dev/null; then
    warn "Conflict detected: Disabling ananicy-cpp to prevent GameMode scheduling issues..."
    sudo systemctl disable --now ananicy-cpp
  else
    info "ananicy-cpp is not active. No conflicts."
  fi
else
  info "Feral's gamemode not installed. Skipping ananicy-cpp conflict check."
fi

info "⚡ Setting scx_lavd (Gaming mode) as the default sched-ext scheduler..."
if command -v scx_loader >/dev/null 2>&1; then
  SCX_CONFIG="/etc/scx_loader/config.toml"
  SCX_WANTED='default_sched = "scx_lavd"
default_mode = "Gaming"'
  sudo systemctl enable --now scx_loader
  if [[ "$(cat "$SCX_CONFIG" 2>/dev/null)" == "$SCX_WANTED" ]]; then
    success "$SCX_CONFIG already set. Skipping."
  else
    sudo cp -a "$SCX_CONFIG" "$SCX_CONFIG.bak" 2>/dev/null || true
    sudo mkdir -p "$(dirname "$SCX_CONFIG")"
    sudo tee "$SCX_CONFIG" >/dev/null <<<"$SCX_WANTED"
    sudo systemctl restart scx_loader
  fi
else
  warn "scx_loader not found (install scx-scheds and scx-tools). Skipping sched-ext setup."
fi

info "[GAMING] Launch options, Proton and Steam settings are manual: see the README's Gaming section."
{{- end }}
