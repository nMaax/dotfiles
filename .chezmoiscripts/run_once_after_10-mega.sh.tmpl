#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

echo ""
info "☁️ [MEGA] Starting..."
echo ""

{{- if ne (printf "%v" .mega_authkey) "false" }}
info "☁️ Installing MEGA CMD..."
if pacman -Qi "megacmd" >/dev/null 2>&1; then
  success "MEGA is already installed. Skipping..."
else
  MEGACMD_PKG="$(mktemp --suffix=.pkg.tar.zst)"
  curl -fsSLo "$MEGACMD_PKG" "$MEGACMD_URL"
  if ! echo "$MEGACMD_SHA256  $MEGACMD_PKG" | sha256sum -c --quiet; then
    rm -f "$MEGACMD_PKG"
    error "MEGAcmd checksum mismatch. Verify the download, then update MEGACMD_SHA256 in external_links.sh.tmpl."
    exit 1
  fi
  sudo pacman -U "$MEGACMD_PKG"
  rm -f "$MEGACMD_PKG"
fi

{{- if .mega_authkey }}
info "Logging into MEGA using provided session key..."
if mega-whoami &>/dev/null; then
  success "Already logged into MEGA. Skipping."
else
  mega-login "{{ .mega_authkey }}"
  success "MEGA login successful."
fi

if ask "🧹 Remove 'mega_authkey' from ~/.config/chezmoi/chezmoi.toml now? (under [data], set mega_authkey = \"\" or false)"; then
  reset_chezmoi_data_secret "mega_authkey" "Leave \"\" or false if you want to skip mega"
fi
{{- else }}
warn "No 'mega_authkey' found in chezmoi.toml. Skipping auto-login."
{{- end }}
{{- else }}
warn "'mega_authkey' set to false. Skipping MEGA entirely."
{{- end }}

echo ""
success "✅ [MEGA] Done."
echo ""
