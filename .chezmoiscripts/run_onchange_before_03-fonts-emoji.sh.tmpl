#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

echo ""
info "🤗 [Fonts and Emoji] Starting..."
echo ""

info "🤓 Installing Nerd Fonts..."
sudo pacman -S --needed --noconfirm ttf-jetbrains-mono-nerd ttf-iosevka-nerd ttf-cascadia-code-nerd

info "🐧 Installing Linux Libertine Fonts..."
sudo pacman -S --needed --noconfirm ttf-linux-libertine

info "🍎 Installing Apple Fonts..."
paru -S --needed --noconfirm apple-fonts

info "😀 Installing Apple Emoji..."
paru -S --needed --noconfirm ttf-apple-emoji

if pacman -Qs noto-fonts-emoji >/dev/null; then
  info "Removing conflicting package: noto-fonts-emoji"
  sudo pacman -Rns --noconfirm noto-fonts-emoji noto-color-emoji-fontconfig
fi

echo ""
success "✅ [Fonts & Emoji] Done."
echo ""
