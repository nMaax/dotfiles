#!/bin/bash
set -euo pipefail

{{ template "utils.sh.tmpl" . }}
{{ template "external_links.sh.tmpl" . }}

echo ""
info "🤗 [Fonts and Emoji] Starting..."
echo ""

info "🤓 Installing Nerd Fonts..."
sudo pacman -S --needed --noconfirm ttf-jetbrains-mono-nerd ttf-iosevka-nerd ttf-cascadia-code-nerd

info "🐧 Installing Linux Libertine Fonts..."
sudo pacman -S --needed --noconfirm ttf-linux-libertine

INSTALL_APPLE_FONTS=true
warn "The apple-fonts AUR package currently fails to build (upstream build issue)."
if ask "Skip installing Apple Fonts until the build is fixed? (recommended)"; then
  INSTALL_APPLE_FONTS=false
fi
if [ "$INSTALL_APPLE_FONTS" = "true" ]; then
  info "🍎 Installing Apple Fonts..."
  paru -S --needed --noconfirm apple-fonts
else
  warn "Skipped Apple Fonts install."
fi

info "😀 Installing Apple Emoji..."
paru -S --needed --noconfirm ttf-apple-emoji

NOTO_EMOJI_PKGS="$(pacman -Qq noto-fonts-emoji noto-color-emoji-fontconfig 2>/dev/null || true)"
if [ -n "$NOTO_EMOJI_PKGS" ]; then
  info "Removing Noto emoji packages: $NOTO_EMOJI_PKGS"
  # shellcheck disable=SC2086
  sudo pacman -Rns --noconfirm $NOTO_EMOJI_PKGS
fi

echo ""
success "✅ [Fonts & Emoji] Done."
echo ""
